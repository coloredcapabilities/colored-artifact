+      tab[i] = p;
+      return;
+    }
+    i = (i + 1) & mask;
+  }
+  tab[i] = p;
+  mjs_slottab_len++;
+}
+
+static void mjs_slottab_register(void *p) {
+  if (!__builtin_cheri_tag_get(p)) return;
+  if (mjs_slottab_cap == 0 || (mjs_slottab_len + 1) * 2 >= mjs_slottab_cap) {
+    size_t ncap = mjs_slottab_cap ? mjs_slottab_cap * 2 : 4096;
+    void **ntab = (void **) calloc(ncap, sizeof(void *));
+    size_t i;
+    if (ntab == NULL) return;
+    mjs_slottab_len = 0;
+    for (i = 0; i < mjs_slottab_cap; i++) {
+      if (mjs_slottab[i] != NULL) mjs_slottab_place(ntab, ncap, mjs_slottab[i]);
+    }
