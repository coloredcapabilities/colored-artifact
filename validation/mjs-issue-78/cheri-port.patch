+#define MJS_SLOT_ADDR_MASK 0xFFFFFFFFFFFFUL
+static void **mjs_slottab = NULL;
+static size_t mjs_slottab_cap = 0;
+static size_t mjs_slottab_len = 0;
+
+static uint64_t mjs_slot_key(void *p) {
+  return (uint64_t) __builtin_cheri_address_get(p) & MJS_SLOT_ADDR_MASK;
+}
+
+static void mjs_slottab_place(void **tab, size_t cap, void *p) {
+  size_t mask = cap - 1;
+  uint64_t a = mjs_slot_key(p);
+  size_t i = (size_t)((a * 0x9E3779B97F4A7C15UL) >> 33) & mask;
+  while (tab[i] != NULL) {
