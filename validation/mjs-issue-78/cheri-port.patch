+#if defined(__CHERI_PURE_CAPABILITY__)
+/*
+ * CHERI purecap port of mjs's NaN-boxed pointers.
+ *
+ * A mjs_val_t is 64-bit and cannot hold a 128-bit capability, so mjs stored
+ * only the 48-bit address and rebuilt pointers with an integer->pointer cast
