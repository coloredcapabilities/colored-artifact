+
+static void mjs_captab_place(void **tab, size_t cap, void *p) {
+  size_t mask = cap - 1;
+  uint64_t a = mjs_cap_key(p);
+  size_t i = mjs_captab_hash(a) & mask;
+  while (tab[i] != NULL) {
+    if (mjs_cap_key(tab[i]) == a) {
+      tab[i] = p; /* freshest capability wins for a reused address */
+      return;
+    }
+    i = (i + 1) & mask;
+  }
+  tab[i] = p;
+  mjs_captab_len++;
+}
+
+static void mjs_captab_register(void *p) {
+  if (!__builtin_cheri_tag_get(p) || mjs_cap_key(p) == 0) return;
+  if (mjs_captab_cap == 0 || (mjs_captab_len + 1) * 2 >= mjs_captab_cap) {
+    size_t ncap = mjs_captab_cap ? mjs_captab_cap * 2 : 2048;
+    void **ntab = (void **) calloc(ncap, sizeof(void *));
+    size_t i;
+    if (ntab == NULL) return; /* OOM: leave unregistered (will fault as before) */
+    mjs_captab_len = 0;
+    for (i = 0; i < mjs_captab_cap; i++) {
