diff --git a/src/njs_vm.h b/src/njs_vm.h
index 7d12b716..35296e0e 100644
--- a/src/njs_vm.h
+++ b/src/njs_vm.h
@@ -58,6 +58,19 @@ typedef enum {
 
 #define NJS_SCOPES             (NJS_SCOPE_CLOSURE + NJS_MAX_NESTING)
 
+/*
+ * NJS_SCOPE_SHIFT encodes the number of low bits reserved for the scope type
+ * in a bytecode operand index.  It also doubles as the alignment guarantee
+ * for ABSOLUTE-scope detection: a raw pointer is ABSOLUTE iff its low
+ * NJS_SCOPE_SHIFT bits are all zero (pointers are at least 2^SHIFT aligned).
+ *
+ * On CHERI purecap sizeof(njs_value_t)==32, but njs_mp_align allocates with
+ * alignment==sizeof(njs_value_t)==32, so raw pointers have low 5 bits zero.
+ * NJS_SCOPE_SHIFT must stay 4 so that NJS_SCOPE_MASK covers only the 4-bit
+ * scope type and ABSOLUTE pointers (low 4 bits == 0) are still detected.
+ * The stride mismatch (NJS_INDEX_GLOBAL_OFFSET=16 < sizeof(njs_value_t)=32)
+ * is fixed separately by redefining NJS_INDEX_GLOBAL_OFFSET below.
+ */
 #define NJS_SCOPE_SHIFT        4
 #define NJS_SCOPE_MASK         ((uintptr_t) ((1 << NJS_SCOPE_SHIFT) - 1))
 
@@ -155,17 +168,44 @@ enum njs_object_e {
 
 
 #define NJS_INDEX_GLOBAL_RETVAL  njs_global_scope_index(1)
+
+/*
+ * CHERI: NJS_INDEX_GLOBAL_OFFSET is used as a byte offset into the global
+ * scope values buffer. With sizeof(njs_value_t)==32 (vs 16 on normal 64-bit),
+ * slot 1 is at byte offset 32, not 16. Override to sizeof(njs_value_t) so the
+ * memcpy in njs_vm_init and the scope_size calculation land on the right slot.
+ */
+#if defined(__CHERI_PURE_CAPABILITY__)
+#define NJS_INDEX_GLOBAL_OFFSET  ((njs_index_t) sizeof(njs_value_t))
+#else
 #define NJS_INDEX_GLOBAL_OFFSET  njs_scope_index(1, 0)
+#endif
 
 
 #define njs_scope_offset(index)                                               \
     ((uintptr_t) (index) & ~NJS_SCOPE_MASK)
 
 
+/*
+ * CHERI: for NJS_SCOPE_ABSOLUTE the index IS the njs_value_t capability
+ * (njs_index_t = uintptr_t = __intcap carries the tag on purecap), so cast
+ * it directly back to a pointer. For all other scopes use base + offset as
+ * usual. The NULL+offset path that the original macro used for ABSOLUTE scope
+ * would take provenance from NULL, yielding an untagged capability.
+ */
+#if defined(__CHERI_PURE_CAPABILITY__)
+#define njs_vmcode_operand(vm, index)                                         \
+    ((((uintptr_t) (index) & NJS_SCOPE_MASK) == NJS_SCOPE_ABSOLUTE)           \
+     ? (njs_value_t *) (void *) (index)                                       \
+     : (njs_value_t *)                                                        \
+       ((u_char *) vm->scopes[(uintptr_t) (index) & NJS_SCOPE_MASK]           \
+        + njs_scope_offset(index)))
+#else
 #define njs_vmcode_operand(vm, index)                                         \
     ((njs_value_t *)                                                          \
      ((u_char *) vm->scopes[(uintptr_t) (index) & NJS_SCOPE_MASK]             \
       + njs_scope_offset(index)))
+#endif
 
 
